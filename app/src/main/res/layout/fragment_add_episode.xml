<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ac_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/top_bar"
        layout="@layout/layout_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/form_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ac_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/form_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ac_text_dim"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Episode number"
                android:textColor="@color/ac_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/episode_number"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/ac_search_field"
                android:hint="1"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ac_text"
                android:textColorHint="@color/ac_text_hint"
                android:textSize="15sp"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Title (optional)"
                android:textColor="@color/ac_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/episode_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/ac_search_field"
                android:hint="e.g. Locusts"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ac_text"
                android:textColorHint="@color/ac_text_hint"
                android:textSize="15sp"
                android:inputType="textCapSentences" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Vimeo link or ID"
                android:textColor="@color/ac_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/video_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/ac_search_field"
                android:hint="https://vimeo.com/76979871"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ac_text"
                android:textColorHint="@color/ac_text_hint"
                android:textSize="15sp"
                android:inputType="textUri" />

            <TextView
                android:id="@+id/video_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Paste a Vimeo link or the video ID."
                android:textColor="@color/ac_text_dim"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Thumbnail link (optional)"
                android:textColor="@color/ac_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/thumb_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/ac_search_field"
                android:hint="Filled in automatically from Vimeo"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ac_text"
                android:textColorHint="@color/ac_text_hint"
                android:textSize="15sp"
                android:inputType="textUri" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/thumb_preview_card"
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ac_chip"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/thumb_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/save_btn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/ac_details_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Add episode"
                android:textColor="@color/ac_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/delete_btn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/ac_genre_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Delete episode"
                android:textColor="#E5484D"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
