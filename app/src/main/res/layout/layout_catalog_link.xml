<?xml version="1.0" encoding="utf-8"?>
<!-- The "Full Anime Catalogue" button on the Videos tab -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="22dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/ac_catalog_link"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Full Anime Catalogue"
        android:textColor="@color/ac_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/catalog_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ac_text_dim"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textColor="@color/ac_text_dim"
        android:textSize="22sp" />
</LinearLayout>
