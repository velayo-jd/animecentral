<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ac_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/top_bar"
        layout="@layout/layout_top_bar" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/details_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/details_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header: blurred poster backdrop that fades out after the top part of the cover -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp">

                <ImageView
                    android:id="@+id/anime_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ac_details_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="120dp"
                        android:layout_height="176dp"
                        app:cardBackgroundColor="@color/ac_chip"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/anime_poster"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Poster"
                            android:scaleType="centerCrop"
                            android:transitionName="anime_poster" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Title with the small "ongoing · 12 eps · 2026" line right under it -->
                    <TextView
                        android:id="@+id/anime_title"
                        android:layout_width="0dp"
                        android:layout_height="176dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="6"
                        android:textColor="@color/ac_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Body: sits straight on the page background, no cards -->
            <LinearLayout
                android:id="@+id/details_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/watch_now_btn"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/ac_details_btn"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_play"
                        android:drawableTint="@color/ac_on_accent"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:text="Watch now"
                        android:textColor="@color/ac_on_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/favorite_btn"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/ac_details_icon_btn"
                        android:contentDescription="Favorite"
                        android:padding="12dp"
                        android:src="@drawable/ic_heart_outline" />

                    <ImageView
                        android:id="@+id/saved_btn"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/ac_details_icon_btn"
                        android:contentDescription="Save anime"
                        android:padding="12dp"
                        android:src="@drawable/ic_saved_outline" />
                </LinearLayout>

                <!-- Synopsis: 3 lines, the last one fades out, chevron expands it -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/anime_synopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="3"
                        android:textColor="@color/ac_text_soft"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/synopsis_toggle"
                        android:layout_width="48dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Expand synopsis"
                        android:paddingHorizontal="12dp"
                        android:src="@drawable/ic_chevron_down"
                        android:visibility="gone" />
                </FrameLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/genre_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/ac_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Episodes"
                        android:textColor="@color/ac_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/episode_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ac_text_dim"
                        android:textSize="13sp" />

                    <!-- Admins only: add an episode -->
                    <ImageView
                        android:id="@+id/add_episode_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Add episode"
                        android:padding="8dp"
                        android:src="@drawable/ic_add"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/no_episodes_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No episodes yet"
                    android:textColor="@color/ac_text_faint"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodes_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
