<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- The whole left side is the tap target: history icon + text -->
    <TextView
        android:id="@+id/row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="20dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:minHeight="52dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:textColor="@color/ac_text"
        android:textSize="16sp"
        app:drawableStartCompat="@drawable/ic_history" />

    <!-- X: removes just this entry -->
    <ImageView
        android:id="@+id/row_remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove"
        android:padding="12dp"
        android:src="@drawable/ic_close_small" />
</LinearLayout>